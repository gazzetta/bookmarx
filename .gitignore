# Database — NEVER commit live database files. A tracked bookmarx.db-wal/.db-shm
# caused two production outages (git reset --hard overwrites them mid-flight).
# deploy.sh aborts if any bookmarx.db* file is ever tracked again.
.backups/
*.db-wal
*.db-shm
.test-extension-profile/
*.pem
*.db
*.db-journal
*.sqlite

# TypeScript incremental build info (stale caches cause phantom errors)
*.tsbuildinfo

# Deploy script server-local state (dependency hash for skipping npm ci)
src/website/.deploy-deps.hash

# ---- Test harness (root tests/ workspace) ----
test-results.junit.xml
coverage/
.vitest/
