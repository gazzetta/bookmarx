{
  "name": "bookmarx-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-component test harness for BookMarx (API / website / extension / mobile). Root package hosts shared test infra only; app code lives under src/.",
  "scripts": {
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:audit": "vitest run --config vitest.audit.config.ts",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results.junit.xml",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "typecheck:mobile": "tsc --noEmit -p src/mobile/tsconfig.json && tsc --noEmit -p tsconfig.mobile-tests.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.4"
  }
}
