{
  "name": "bookmarx-extension",
  "version": "1.0.0",
  "description": "BookMarx browser extension",
  "scripts": {
    "build": "npm run build:all",
    "build:chrome": "webpack --config webpack.config.js --env browser=chrome",
    "build:firefox": "webpack --config webpack.config.js --env browser=firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "build:release": "webpack --config webpack.config.js --env browser=chrome --env production=true && webpack --config webpack.config.js --env browser=firefox --env production=true",
    "watch": "webpack --config webpack.config.js --watch",
    "watch:firefox": "webpack --config webpack.config.js --watch --env browser=firefox",
    "clean": "rimraf dist dist-firefox",
    "build:clean": "npm run clean && npm run build:all",
    "dev": "webpack --config webpack.config.js --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"./**/*.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^20.0.0",
    "@types/webextension-polyfill": "^0.12.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.0.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
