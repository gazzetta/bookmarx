{
    "manifest_version": 3,
    "name": "BookMarx",
    "key": "",
    "version": "1.0.0",
    "description": "Cross-browser bookmark synchronization system",
    "permissions": [
        "bookmarks",
        "storage",
        "identity",
        "alarms",
        "notifications"
    ],
    "oauth2": {
        "client_id": "669480413219-orsc4922bls6jir2thbslsssi6p0tkjg.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    },
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/index.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "pages/*",
                "pages/master-collection.html",
                "pages/master-collection.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "host_permissions": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
    ]
}