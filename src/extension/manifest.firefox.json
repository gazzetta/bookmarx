{
    "manifest_version": 2,
    "name": "BookMarx",
    "version": "1.0.0",
    "description": "Cross-browser bookmark synchronization system",
    "permissions": [
        "bookmarks",
        "storage",
        "alarms",
        "notifications",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "bookmarx@example.com",
            "strict_min_version": "109.0"
        }
    },
    "background": {
        "scripts": ["background/index.js"],
        "persistent": false
    },
    "browser_action": {
        "default_popup": "popup/index.html"
    },
    "web_accessible_resources": [
        "pages/*",
        "pages/master-collection.html",
        "pages/master-collection.js"
    ]
}
