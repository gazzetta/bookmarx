# BookMarx Production Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3005

# Database
# SQLite database path (relative to server directory)
DATABASE_PATH=./data/bookmarx.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API Configuration
API_BASE_URL=https://api.bookmarx.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=https://bookmarx.app,chrome-extension://your-extension-id
